{
  "name": "bytic/orm-filters",
  "type": "library",
  "description": "Filter sessions and queries for the Nip ORM",
  "homepage": "https://github.com/ByTIC/orm-filters",
  "license": "MIT",
  "authors": [
    {
      "name": "Gabriel Solomon",
      "email": "hello@gabrielsolomon.ro"
    }
  ],
  "autoload": {
    "psr-4": {
      "Nip\\Records\\Filters\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nip\\Records\\Filters\\Tests\\": "tests/src",
      "Nip\\Records\\Filters\\Tests\\Fixtures\\": "tests/fixtures"
    }
  },
  "require": {
    "php": "^8.0",
    "bytic/collections": "^1.0|^2.0",
    "bytic/database": "^1.0|^2.0",
    "bytic/http": "^1.0|^2.0",
    "bytic/utility": "^1.0",
    "psr/http-message": "^1.0|^2.0",
    "symfony/http-foundation": "^5.4|^6.0|^7.0|^8.0"
  },
  "require-dev": {
    "bytic/phpqatools": "^1.0",
    "bytic/orm": "^1.0|^2.0",
    "mockery/mockery": "^1.0",
    "nyholm/psr7": "^1.3"
  }
}
